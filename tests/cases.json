      "capture": {
        "kind": "exception",
        "type": "Error",
        "message": "ResizeObserver loop limit exceeded"
      },
      "requests": [],
      "after": "ok"
    },
    {
      "name": "429 → uma nova tentativa (mesmo corpo)",
      "init": {
        "key": "bf_mon_conformance",
        "release": "1.4.2",
        "environment": "staging"
      },
      "capture": {
        "kind": "exception",
        "type": "E",
