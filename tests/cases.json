            },
            "header_prefix": {
              "X-bFocus-Client": "bfocus-monitor-"
            },
            "event": {
              "exception.message": "retry"
            }
          },
          "respond": {
            "status": 202,
            "body": {
              "accepted": 1
            }
          }
        }
      ],
      "after": "ok"
    },
    {
      "name": "401 → descarta e para de enviar até o próximo init",
      "init": {
        "key": "bf_mon_conformance",
        "release": "1.4.2",
        "environment": "staging"
      },
      "capture": {
        "kind": "exception",
