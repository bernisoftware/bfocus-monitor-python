  "send": [
    {
      "name": "erro simples leva release, ambiente, nível, tipo, mensagem e sdk",
      "init": {
        "key": "bf_mon_conformance",
        "release": "1.4.2",
        "environment": "staging"
      },
      "capture": {
        "kind": "exception",
        "type": "ValueError",
        "message": "valor inválido"
      },
      "requests": [
        {
          "expect": {
            "method": "POST",
            "path": "/api/v1/monitor/events",
            "headers": {
              "X-bFocus-Monitor-Key": "bf_mon_conformance",
              "Content-Type": "application/json"
            },
            "header_prefix": {
              "X-bFocus-Client": "bfocus-monitor-"
            },
            "event": {
              "release": "1.4.2",
              "environment": "staging",
              "level": "error",
              "exception.type": "ValueError",
              "exception.message": "valor inválido",
              "sdk.version": "$version"
            }
          },
          "respond": {
            "status": 202,
            "body": {
              "accepted": 1,
              "dropped": 0,
              "invalid": 0,
              "ignored": 0
            }
          }
        }
      ],
      "after": "ok"
    },
    {
      "name": "identidade assinada pelo próprio pacote com signingSecret",
      "init": {
        "key": "bf_mon_conformance",
        "release": "1.4.2",
        "environment": "staging",
        "signing_secret": "whs_secret_A"
      },
      "set_user": {
        "user_external_id": "u-123",
        "customer_external_id": "cliente-9",
        "ts": 1760000000
      },
      "capture": {
        "kind": "exception",
        "type": "KeyError",
        "message": "pedido"
      },
      "requests": [
        {
          "expect": {
            "method": "POST",
            "path": "/api/v1/monitor/events",
            "headers": {
              "X-bFocus-Monitor-Key": "bf_mon_conformance",
              "Content-Type": "application/json"
            },
            "header_prefix": {
              "X-bFocus-Client": "bfocus-monitor-"
            },
            "event": {
              "user.externalId": "u-123",
              "customer.externalId": "cliente-9",
              "user.userHash": "v2.1760000000.576dbbed2ebc9be9f4c61a68eaf61f763ae5c16efbe7dcd71ba128f3305523af"
            }
          },
          "respond": {
            "status": 202,
            "body": {
              "accepted": 1
            }
          }
        }
      ],
      "after": "ok"
    },
    {
